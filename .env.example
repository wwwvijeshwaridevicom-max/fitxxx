# FITXXX STREETWEAR ENVIRONMENT CONFIGURATION
# Production & Local Setup

# Base App URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Authentication & Database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Razorpay Payment Gateway (Indian & International Payments)
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourKeyIdHere
RAZORPAY_KEY_SECRET=your_razorpay_secret_here
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret_here

# Currency Settings
NEXT_PUBLIC_DEFAULT_CURRENCY=INR
NEXT_PUBLIC_CURRENCY_SYMBOL=₹

# Owner Admin Security
ADMIN_BOOTSTRAP_PASSWORD=your_secure_owner_password_here
ADMIN_OWNER_PHONE=9816357615
ADMIN_OWNER_EMAIL=JATTSHIV32@GMAIL.COM
ADMIN_SESSION_SECRET=your_admin_session_jwt_secret_here
